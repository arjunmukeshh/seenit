{
  "name": "seenit",
  "version": "0.2.0",
  "type": "module",
  "description": "Has this already been written? Asks a copy/paste detector the question it does not answer — before you write, not after. Matches through renames and reformatting.",
  "keywords": [
    "duplicate-code",
    "copy-paste-detection",
    "clone-detection",
    "jscpd",
    "tree-sitter",
    "mcp",
    "mcp-server",
    "claude-code",
    "ai-agents",
    "code-quality"
  ],
  "license": "MIT",
  "author": "Arjun Mukesh",
  "homepage": "https://github.com/arjunmukeshh/seenit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunmukeshh/seenit.git"
  },
  "bugs": {
    "url": "https://github.com/arjunmukeshh/seenit/issues"
  },
  "bin": {
    "seenit": "bin/seenit.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "bin/",
    "lib/",
    "mcp/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "media": "node docs/media/build.mjs",
    "recall": "node calibration/recall.mjs --repos 63 --concurrency 4",
    "prepublishOnly": "npm test",
    "precision": "node calibration/precision.mjs --repos 60 --concurrency 4 && node calibration/score-precision.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "jscpd": "^5.0.14",
    "web-tree-sitter": "0.26.11"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
